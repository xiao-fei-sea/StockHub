-- 28. stock_alert_rule 库存预警规则表
CREATE TABLE IF NOT EXISTS stock_alert_rule (
    id              BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
    rule_name       VARCHAR(100) NOT NULL COMMENT '规则名称',
    warehouse_id    BIGINT UNSIGNED DEFAULT NULL COMMENT '仓库ID（warehouse.id，为空表示全部仓库）',
    category_id     BIGINT UNSIGNED DEFAULT NULL COMMENT '商品分类ID（product_category.id，为空表示全部分类）',
    product_id      BIGINT UNSIGNED DEFAULT NULL COMMENT '商品ID（product.id，为空表示全部商品）',
    alert_type      TINYINT      NOT NULL COMMENT '预警类型：1低于下限LOW_STOCK/2高于上限HIGH_STOCK/3临近保质期NEAR_EXPIRY/4已过期EXPIRED',
    threshold_value DECIMAL(12,3) DEFAULT NULL COMMENT '通用阈值（适用上下限或临近天数）',
    near_days       INT          DEFAULT NULL COMMENT '临近保质期天数（alert_type=3 时有效）',
    min_qty         DECIMAL(12,3) DEFAULT NULL COMMENT '库存下限（alert_type=1 时有效）',
    max_qty         DECIMAL(12,3) DEFAULT NULL COMMENT '库存上限（alert_type=2 时有效）',
    status          TINYINT      NOT NULL DEFAULT 1 COMMENT '规则状态：0停用/1启用',
    remark          VARCHAR(500) DEFAULT NULL COMMENT '备注',
    create_time     DATETIME     DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    update_time     DATETIME     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    create_by       BIGINT UNSIGNED DEFAULT NULL COMMENT '创建人ID（sys_user.id）',
    update_by       BIGINT UNSIGNED DEFAULT NULL COMMENT '更新人ID（sys_user.id）',
    deleted         TINYINT(1)   NOT NULL DEFAULT 0 COMMENT '逻辑删除标记：0未删除/1已删除',
    PRIMARY KEY (id),
    KEY idx_alert_rule_warehouse (warehouse_id),
    KEY idx_alert_rule_category (category_id),
    KEY idx_alert_rule_product (product_id)
) ENGINE = InnoDB
  DEFAULT CHARSET = utf8mb4
  COLLATE = utf8mb4_0900_ai_ci
  COMMENT = '库存预警规则表（每日定时扫描规则，不实时拦截业务）';

-- 29. stock_alert_record 库存预警记录表
CREATE TABLE IF NOT EXISTS stock_alert_record (
    id              BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键ID',
    rule_id         BIGINT UNSIGNED DEFAULT NULL COMMENT '预警规则ID（stock_alert_rule.id，逻辑外键）',
    alert_type      TINYINT      NOT NULL COMMENT '预警类型：1低于下限/2高于上限/3临近保质期/4已过期',
    warehouse_id    BIGINT UNSIGNED NOT NULL COMMENT '仓库ID（warehouse.id，逻辑外键）',
    product_id      BIGINT UNSIGNED NOT NULL COMMENT '商品ID（product.id，逻辑外键）',
    batch_id        BIGINT UNSIGNED DEFAULT NULL COMMENT '批次ID（inventory_batch.id，可空）',
    current_value   DECIMAL(12,3) DEFAULT NULL COMMENT '当前值（当前库存或距过期天数）',
    threshold_value DECIMAL(12,3) DEFAULT NULL COMMENT '阈值',
    level           TINYINT      NOT NULL DEFAULT 1 COMMENT '预警级别：1提示/2警告/3严重',
    status          TINYINT      NOT NULL DEFAULT 0 COMMENT '处理状态：0未处理/1已处理',
    handle_remark   VARCHAR(500) DEFAULT NULL COMMENT '处理说明',
    handle_user     BIGINT UNSIGNED DEFAULT NULL COMMENT '处理人ID（sys_user.id）',
    handle_time     DATETIME     DEFAULT NULL COMMENT '处理时间',
    create_time     DATETIME     DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    update_time     DATETIME     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    create_by       BIGINT UNSIGNED DEFAULT NULL COMMENT '创建人ID（sys_user.id）',
    update_by       BIGINT UNSIGNED DEFAULT NULL COMMENT '更新人ID（sys_user.id）',
    deleted         TINYINT(1)   NOT NULL DEFAULT 0 COMMENT '逻辑删除标记：0未删除/1已删除',
    PRIMARY KEY (id),
    KEY idx_alert_record_rule (rule_id),
    KEY idx_alert_record_warehouse (warehouse_id),
    KEY idx_alert_record_product (product_id),
    KEY idx_alert_record_batch (batch_id)
) ENGINE = InnoDB
  DEFAULT CHARSET = utf8mb4
  COLLATE = utf8mb4_0900_ai_ci
  COMMENT = '库存预警记录表（规则与结果分表，避免混淆）';

